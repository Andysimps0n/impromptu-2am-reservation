{
  "name": "impromptu-2am-ticketing-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build-site.mjs",
    "build:vercel": "node scripts/build-vercel.mjs",
    "build:cloudflare": "node scripts/build-site.mjs",
    "deploy:cloudflare": "npm run build:cloudflare && node scripts/cloudflare.mjs deploy",
    "migrate:cloudflare": "node scripts/cloudflare.mjs d1 migrations apply DB --remote",
    "set:cloudflare-admin-password": "node scripts/cloudflare.mjs set-admin-password",
    "set:cloudflare-sms-secrets": "node scripts/cloudflare.mjs set-sms-secrets"
  },
  "devDependencies": {
    "wrangler": "^4.151.0"
  }
}
