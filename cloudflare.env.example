# Copy this file to .env.cloudflare; .env.cloudflare is ignored by Git.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
ADMIN_PASSWORD=
# Kakao login. Leave CLIENT_SECRET empty unless Client Secret is enabled in the Kakao console.
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=
ADMIN_KAKAO_IDS=
# Set to 1 only while the old password login should stay available.
ADMIN_PASSWORD_LOGIN=
# Set to 1 to require Kakao login before booking and limit seats per Kakao member id.
REQUIRE_KAKAO_BOOKING=
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_FROM_NUMBER=
