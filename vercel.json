{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "vercel-dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://impromptu-2am-ticketing.impromptu2ticket.workers.dev/api/:path*"
    },
    {
      "source": "/(booking|booking/.*|admin|admin/.*|ticket)",
      "destination": "/index.html"
    }
  ]
}
