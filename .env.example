# 로컬 개발: 이 파일을 .dev.vars 로 복사한 뒤 값을 채우세요.
#   cp .env.example .dev.vars
# wrangler dev 는 프로젝트 루트의 .dev.vars 를 자동으로 읽습니다.
# .dev.vars 와 .env.cloudflare 는 Git에 올리지 마세요.
#
# 배포 환경의 키는 wrangler.jsonc 에 적지 말고 secret 으로만 넣으세요.
#   npx wrangler secret put KAKAO_REST_API_KEY
#   npx wrangler secret put KAKAO_CLIENT_SECRET
#   npx wrangler secret put KAKAO_REDIRECT_URI
#   npx wrangler secret put ADMIN_KAKAO_IDS
# .env.cloudflare 에 같은 이름을 적어 두었다면:
#   npm run set:cloudflare-kakao-secrets

# 카카오 개발자 콘솔 > 앱 > 앱 키 > REST API 키
KAKAO_REST_API_KEY=

# 카카오 로그인에서 Client Secret을 켰을 때만 넣습니다. 끄면 비워 두세요.
KAKAO_CLIENT_SECRET=

# 카카오 콘솔에 등록한 Redirect URI와 글자까지 같아야 합니다.
# 로컬 예: http://localhost:8787/auth/kakao/callback
# 배포 예: https://impromptu-2am-ticketing.impromptu2ticket.workers.dev/auth/kakao/callback
KAKAO_REDIRECT_URI=

# 운영진으로 인정할 카카오 회원번호. 쉼표로 구분합니다. 닉네임이나 이메일은 쓰지 않습니다.
# 예: 1234567890,2345678901
ADMIN_KAKAO_IDS=

# 1 이면 기존 아이디/비밀번호 로그인을 잠시 남겨 둡니다. 비우거나 0 이면 카카오 로그인만 사용합니다.
ADMIN_PASSWORD_LOGIN=
# 비밀번호 로그인을 켤 때만 사용합니다. 아이디는 wrangler.jsonc 의 ADMIN_USERNAME 이어도 됩니다.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# 1 이면 일반 예매도 카카오 로그인 후에만 가능하고, 카카오 회원번호마다 회차당 4석으로 제한합니다.
REQUIRE_KAKAO_BOOKING=
